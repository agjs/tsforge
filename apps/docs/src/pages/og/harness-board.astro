---
import "../../styles/custom.css";
import "../../styles/landing.css";
import HarnessBoardDiagram from "../../components/HarnessBoardDiagram.astro";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1200" />
    <title>tsforge harness board</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
        background: #0f1218;
      }

      .og-harness-board {
        width: 1200px;
        height: 630px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
    </style>
  </head>
  <body>
    <div class="og-harness-board">
      <HarnessBoardDiagram ogMode linked={false} showCaption={false} />
    </div>
  </body>
</html>
