---
import Icon from "./Icon.astro";
import GateScene from "./GateScene.astro";

const INSTALL = "curl -fsSL https://tsforge.dev/install.sh | bash";
---

<section class="relative hairline-b overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-background/40 via-background/70 to-background"
  >
  </div>
  <div class="pointer-events-none absolute inset-0 grid-bg opacity-30"></div>

  <div
    class="relative mx-auto max-w-[1400px] px-6 pt-20 pb-16 md:pt-28 md:pb-32 grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-20 items-center"
  >
    <div class="animate-fade-up min-w-0">
      <div class="flex items-center gap-3 mb-8">
        <span class="h-px w-8 bg-primary"></span>
        <span class="mono-caps !text-[color:var(--color-primary)]">Full-stack TypeScript Harness</span>
      </div>

      <h1
        class="font-mono text-[32px] sm:text-[48px] lg:text-[64px] leading-[1.04] tracking-[-0.03em] font-medium"
      >
        Ship TypeScript<br />
        that <span class="text-primary italic font-normal">can't cheat</span>.
      </h1>

      <p class="mt-7 max-w-[52ch] text-[15px] leading-relaxed text-muted-foreground">
        A harness with <span class="text-foreground">161 enforced rules</span> for full-stack
        TypeScript — React, Next, Node, Bun, Drizzle, Fastify, Three.js, and more. The build doesn't
        finish until the gate passes.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="/quickstart/"
          class="group inline-flex items-center gap-2 bg-primary text-primary-foreground h-11 px-5 font-medium text-[13px] tracking-tight hover:bg-primary/90 transition-colors"
        >
          Get started
          <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
        </a>
        <a
          href="https://github.com/agjs/tsforge"
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex items-center gap-2 border border-border h-11 px-5 text-[13px] hover:border-border-strong transition-colors"
        >
          <Icon name="github" class="h-3.5 w-3.5" />
          GitHub
        </a>
      </div>

      <div class="mt-10 max-w-[520px]">
        <div class="mono-caps mb-2">Install</div>
        <div class="flex items-stretch border border-border bg-card/60">
          <div class="flex items-center gap-2 px-3 hairline-r text-muted-foreground">
            <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
            <span class="font-mono text-[11px]">$</span>
          </div>
          <code
            class="min-w-0 flex-1 px-3 py-3 font-mono text-[12.5px] text-foreground whitespace-nowrap overflow-x-auto"
            >{INSTALL}</code
          >
          <button
            type="button"
            data-copy={INSTALL}
            class="tf-copy grid place-items-center bg-transparent px-3 hairline-l text-muted-foreground hover:text-foreground transition-colors"
            aria-label="Copy install command"
          >
            <Icon name="copy" class="h-3.5 w-3.5" />
          </button>
        </div>
        <p class="mt-2 font-mono text-[11px] text-muted-foreground">
          Requires Bun. <a href="/quickstart/" class="text-primary hover:underline">Other install paths</a>
          <span class="text-muted-foreground/70">(npm <code>@agjs/tsforge</code>, from source).</span>
        </p>
      </div>
    </div>

    <div class="animate-fade-up [animation-delay:120ms] min-w-0">
      <GateScene />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".tf-copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      try {
        await navigator.clipboard.writeText(text);
        // Visual feedback for sighted users (CSS swaps the icon to a check)
        // plus the accessible label for screen readers.
        btn.dataset.copied = "1";
        btn.setAttribute("aria-label", "Copied");
        window.setTimeout(() => {
          delete btn.dataset.copied;
          btn.setAttribute("aria-label", "Copy install command");
        }, 2000);
      } catch {
        btn.dataset.copied = "error";
        btn.setAttribute("aria-label", "Copy failed — select and copy manually");
        window.setTimeout(() => {
          delete btn.dataset.copied;
          btn.setAttribute("aria-label", "Copy install command");
        }, 2000);
      }
    });
  });
</script>
