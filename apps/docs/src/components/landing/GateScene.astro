---
/* The hero's right-column animation: typed tokens flow through the gate, unsafe
   ones get rejected. Ported from the Lovable design (pure CSS keyframes). */
interface Token {
  text: string;
  kind: "bad" | "good";
  top: string;
  delay: string;
  duration: string;
}

const tokens: Token[] = [
  { text: "as any", kind: "bad", top: "12%", delay: "0s", duration: "5.5s" },
  { text: "satisfies User", kind: "good", top: "22%", delay: "0.8s", duration: "5s" },
  { text: "// @ts-ignore", kind: "bad", top: "32%", delay: "1.6s", duration: "6s" },
  { text: "Brand<UUID>", kind: "good", top: "42%", delay: "2.2s", duration: "5.2s" },
  { text: "function f(x) {}", kind: "bad", top: "52%", delay: "3s", duration: "5.6s" },
  { text: "Result<T, E>", kind: "good", top: "62%", delay: "3.6s", duration: "5s" },
  { text: "any[]", kind: "bad", top: "72%", delay: "4.2s", duration: "5.4s" },
  { text: "ReadonlyDeep<T>", kind: "good", top: "82%", delay: "4.8s", duration: "5s" },
];

const corners = [
  "top-0 left-0",
  "top-0 right-0 rotate-90",
  "bottom-0 right-0 rotate-180",
  "bottom-0 left-0 -rotate-90",
];
---

<div
  class="relative w-full aspect-[5/6] md:aspect-[4/5] overflow-hidden border border-border bg-card/40 grid-bg"
>
  {
    corners.map((c) => (
      <div class={`absolute h-3 w-3 ${c}`}>
        <div class="absolute top-0 left-0 h-px w-3 bg-primary" />
        <div class="absolute top-0 left-0 w-px h-3 bg-primary" />
      </div>
    ))
  }

  <div class="absolute inset-y-0 left-0 w-px bg-border"></div>
  <div class="absolute left-2 top-3 mono-caps !text-[9px]">source</div>

  <div class="absolute inset-y-8 left-1/2 -translate-x-1/2 flex flex-col items-center">
    <div class="mono-caps !text-[9px] mb-2 !text-[color:var(--color-primary)]">gate</div>
    <div class="relative flex-1 w-px bg-border-strong">
      <div
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-24 w-[3px] bg-primary animate-gate-pulse"
      >
      </div>
    </div>
    <div class="mono-caps !text-[9px] mt-2">exit 0</div>
  </div>

  <div class="absolute inset-y-0 right-0 w-px bg-border"></div>
  <div class="absolute right-2 top-3 mono-caps !text-[9px]">build</div>

  <div class="absolute inset-0">
    {
      tokens.map((t) => (
        <div
          class="absolute left-0 w-full"
          style={`top:${t.top};animation:${t.kind === "good" ? "token-flow" : "token-reject"} ${t.duration} cubic-bezier(.4,0,.2,1) ${t.delay} infinite;`}
        >
          <span
            class={
              t.kind === "good"
                ? "inline-block font-mono text-[12px] px-2 py-0.5 border border-primary/50 text-primary bg-primary/5 whitespace-nowrap"
                : "inline-block font-mono text-[12px] px-2 py-0.5 border border-destructive/60 text-destructive bg-destructive/5 line-through decoration-destructive/70 whitespace-nowrap"
            }
          >
            {t.text}
          </span>
        </div>
      ))
    }
  </div>

  <div class="absolute bottom-5 right-5">
    <div
      class="border-2 border-success px-3 py-1.5 font-mono text-[11px] tracking-widest text-success animate-stamp-in"
    >
      ✓ GATE PASSED
    </div>
  </div>

  <div
    class="absolute bottom-5 left-5 font-mono text-[10px] text-muted-foreground leading-tight"
  >
    <div>tsc --noEmit · <span class="text-success">pass</span></div>
    <div>eslint(tsforge) · <span class="text-success">pass</span></div>
    <div>bun test · <span class="text-success">ok</span></div>
    <div class="text-foreground/80">checkpoint · <span class="text-primary">saved</span></div>
  </div>
</div>
