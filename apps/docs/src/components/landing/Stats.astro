---
const stats = [
  { value: "161", label: "Enforced rules", sub: "Hand-tuned, opinionated" },
  { value: "0", label: "Escape hatches", sub: "No `any`. No `@ts-ignore`." },
  { value: "strict", label: "Type checking", sub: "tsc strict + type-aware ESLint" },
  { value: "gate", label: "Required to merge", sub: "Build stops until green" },
];
---

<section class="hairline-b">
  <div class="mx-auto max-w-[1400px] px-6 grid grid-cols-2 md:grid-cols-4">
    {
      stats.map((s, i) => (
        <div class={`py-8 md:py-12 ${i > 0 ? "md:hairline-l md:pl-8" : "md:pr-8"}`}>
          <div class="font-mono text-[32px] md:text-[44px] leading-none tracking-tight">
            {s.value}
          </div>
          <div class="mt-3 text-[13px] text-foreground">{s.label}</div>
          <div class="mt-1 font-mono text-[11px] text-muted-foreground">{s.sub}</div>
        </div>
      ))
    }
  </div>
</section>
