---
/* A sliver of the real ruleset — typescript-eslint rules we enforce plus a few
   tsforge pack rules from packages/core/RULES.md. */
const rules = [
  "no-floating-promises", "no-unchecked-indexed-access", "no-explicit-any",
  "no-misused-promises", "consistent-type-imports", "no-non-null-assertion",
  "strict-boolean-expressions", "no-unsafe-argument", "no-unsafe-return",
  "require-await", "switch-exhaustiveness-check", "prefer-nullish-coalescing",
  "ban-ts-comment", "no-unsafe-assignment", "no-unsafe-call",
  "no-unsafe-member-access", "update-delete-must-have-where",
  "jwt-must-verify-not-decode", "no-user-controlled-fetch-url",
  "no-user-controlled-redirect", "auth-cookie-must-set-samesite",
  "no-auth-token-in-storage", "catch-must-handle",
  "no-prototype-polluting-merge", "webhook-must-verify-signature-before-parse",
  "no-secret-props-to-client", "upload-must-set-limits", "test-sibling-required",
];

const doubled = [...rules, ...rules];
---

<section class="hairline-b py-12 bg-card/20 overflow-hidden relative">
  <div class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-background to-transparent z-10"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-background to-transparent z-10"></div>

  <div class="mx-auto max-w-[1400px] px-6 mb-6 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="h-px w-8 bg-primary"></span>
      <span class="mono-caps">A sliver of the ruleset</span>
    </div>
    <span class="mono-caps !text-[10px]">184 enforced · 0 optional</span>
  </div>

  <div class="flex gap-3 whitespace-nowrap animate-marquee w-max">
    {
      doubled.map((r) => (
        <span class="font-mono text-[12px] px-3 py-1.5 border border-border bg-card/40 text-muted-foreground">
          {r}
        </span>
      ))
    }
  </div>
</section>
