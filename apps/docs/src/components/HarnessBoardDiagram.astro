---
/** Harness composition diagram — illustrated board + doc links. */
interface ISubsystem {
  title: string;
  subtext: string;
  href: string;
}

interface Props {
  variant?: "full" | "compact";
  showCaption?: boolean;
  linked?: boolean;
  /** Fixed dark styling for OG export page — image only, no links. */
  ogMode?: boolean;
}

const {
  variant = "full",
  showCaption = true,
  linked = true,
  ogMode = false,
} = Astro.props;

const isCompact = variant === "compact";
const showSubtext = !isCompact && !ogMode;
const showLinks = linked && !ogMode;

const subsystems: readonly ISubsystem[] = [
  {
    title: "MODEL",
    subtext: "reasons → tool calls",
    href: "/agent/model-agent/",
  },
  {
    title: "STACK",
    subtext: "detection, rule packs, constitution",
    href: "/guardrails/stack-detection/",
  },
  {
    title: "LOOP",
    subtext: "orchestration, plan mode, repair cycles",
    href: "/loop/validation/",
  },
  {
    title: "GATE",
    subtext: "tsc, ESLint, tests",
    href: "/loop/gate-floor/",
  },
  {
    title: "TOOLS",
    subtext: "read, edit, shell, MCP, scaffold",
    href: "/edit/engine/",
  },
  {
    title: "SESSION",
    subtext: "CLI, config, checkpoints, render",
    href: "/cli/interactive/",
  },
];

const altText =
  "tsforge harness board: MODEL at center connected to STACK, LOOP, GATE, TOOLS, and SESSION subsystems inside a HARNESS boundary.";
---

<section
  class:list={[
    "tf-harness-board",
    isCompact && "tf-harness-board--compact",
    ogMode && "tf-harness-board--og",
  ]}
  aria-label="tsforge harness composition"
>
  <div class="tf-harness-board__frame">
    <img
      class="tf-harness-board__img tf-harness-board__img--dark"
      src="/harness-board.png"
      width="1376"
      height="768"
      alt={altText}
      loading="lazy"
      decoding="async"
    />
    {
      !ogMode && (
        <img
          class="tf-harness-board__img tf-harness-board__img--light"
          src="/harness-board-light.png"
          width="1376"
          height="768"
          alt={altText}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>

  {
    showLinks && (
      <nav class="tf-harness-board__links" aria-label="Harness subsystems">
        <ul class="tf-harness-board__link-list">
          {subsystems.map((node) => (
            <li>
              <a href={node.href} class="tf-harness-board__link">
                <strong>{node.title}</strong>
                {showSubtext && <span>{node.subtext}</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    showCaption && (
      <p class="tf-diagram-caption">
        <em>The model is one chip on the board. The harness is everything else that makes TypeScript merge-ready.</em>
      </p>
    )
  }
</section>
