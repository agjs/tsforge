---
/*
 * Starlight ThemeProvider override — dark-only.
 *
 * The site uses a single OKLCH dark palette (the Lovable "TypeSafe Haven"
 * design has no light variant), so we force `data-theme="dark"` unconditionally
 * and drop the picker. Inlined to avoid any flash.
 */
---

<script is:inline>
  document.documentElement.dataset.theme = "dark";
  window.StarlightThemeProvider = {
    updatePickers() {
      /* dark-only — nothing to update */
    },
  };
</script>
