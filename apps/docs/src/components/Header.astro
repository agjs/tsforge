---
import config from "virtual:starlight/user-config";
import Search from "virtual:starlight/components/Search";
import pkg from "../../package.json";

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";

const navItems = [
  { href: "/quickstart/", label: "Quickstart" },
  { href: "/big-picture/", label: "How it works" },
  { href: "/loop/gate-floor/", label: "The gate" },
  { href: "/cli/interactive/", label: "CLI" },
  { href: "/reference/commands/", label: "Reference" },
];

const version = `v${pkg.version}`;
---

<div class="tf-nav mx-auto flex h-full w-full max-w-[1400px] items-center gap-8 px-6">
  <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="tsforge home">
    <span
      class="grid h-6 w-6 place-items-center bg-primary text-primary-foreground font-mono text-[11px] font-bold"
      >ƒ</span
    >
    <span class="font-mono text-[15px] font-medium tracking-tight text-foreground">tsforge</span>
    <span class="ml-1 h-4 hairline-l"></span>
    <span class="mono-caps !text-[10px]">{version}</span>
  </a>

  <nav class="hidden md:flex items-center gap-7 text-[13px] text-muted-foreground" aria-label="Primary">
    {
      navItems.map((item) => (
        <a class="no-underline hover:text-foreground transition-colors" href={item.href}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="ml-auto flex items-center gap-2">
    {shouldRenderSearch && <div class="tf-nav-search min-w-0 print:hidden"><Search /></div>}
    <a
      class="flex items-center gap-2 border border-border h-9 px-3 text-[12px] text-foreground no-underline hover:border-border-strong transition-colors"
      href="https://github.com/agjs/tsforge"
      rel="noopener noreferrer"
      target="_blank"
      aria-label="tsforge on GitHub"
    >
      <svg class="h-[1rem] w-[1rem]" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor">
        <path
          fill-rule="evenodd"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
      <span class="font-mono max-[60rem]:sr-only">GitHub</span>
    </a>
  </div>
</div>
