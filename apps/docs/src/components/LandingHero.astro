---
import DraftContentNotice from "virtual:starlight/components/DraftContentNotice";
import HarnessLoopDiagram from "./HarnessLoopDiagram.astro";
import InstallSnippet from "./InstallSnippet.tsx";
import HarnessPillars from "./HarnessPillars.astro";

const { data } = Astro.locals.starlightRoute.entry;
---

<section class="tf-landing-hero hero">
  <div class="tf-landing-hero__grid">
    <div class="tf-landing-hero__copy stack sl-flex">
      <h1 id="_top" class="tf-landing-headline" data-page-title>
        The harness for <span class="tf-accent">TypeScript</span> apps
      </h1>

      {data.draft && <DraftContentNotice />}

      <p class="tf-landing-lede">
        {data.hero?.tagline ??
          "Run a model against your repo. tsforge edits files, runs tsc and ESLint, and loops until the gate passes."}
      </p>

      <div class="tf-landing-actions">
        <a class="tf-landing-actions__primary" href="/quickstart/">Try it</a>
        <a class="tf-landing-actions__secondary" href="/big-picture/">How it works</a>
        <a
          class="tf-landing-actions__secondary"
          href="https://github.com/agjs/tsforge"
          rel="noopener noreferrer"
          target="_blank"
        >
          GitHub
        </a>
      </div>

      <InstallSnippet client:load />
    </div>

    <HarnessLoopDiagram />
  </div>
</section>

<HarnessPillars />
