---
interface IDocCard {
  title: string;
  description: string;
  href: string;
  linkLabel: string;
}

const cards: readonly IDocCard[] = [
  {
    title: "CLI & sessions",
    description: "Interactive REPL, slash commands, flags, and session persistence.",
    href: "/cli/interactive/",
    linkLabel: "Interactive CLI →",
  },
  {
    title: "The check & retry loop",
    description: "How tsforge decides a task is done, and hands the exact errors back so the model keeps fixing.",
    href: "/loop/gate-floor/",
    linkLabel: "How the gate is built →",
  },
  {
    title: "TypeScript intelligence",
    description: "The same engine that powers VS Code, built in — for code navigation and instant feedback on each edit.",
    href: "/lsp/typescript-server/",
    linkLabel: "Language server →",
  },
  {
    title: "Web scaffolding",
    description: "Spin up a fresh Vite + React app inside a session, checked all the way to a browser smoke test.",
    href: "/scaffold/web/",
    linkLabel: "Web scaffolding →",
  },
  {
    title: "Guardrails",
    description: "Automatic lint rules tuned to your stack (React, Drizzle, and more) — and how to tune them.",
    href: "/guardrails/stack-detection/",
    linkLabel: "Stack detection →",
  },
  {
    title: "Keeping the model honest",
    description: "How tsforge catches bad edits early — fixing broken tool calls, anchoring line edits, and stopping bad output mid-stream.",
    href: "/uplift/repair-ladder/",
    linkLabel: "Fix bad tool calls →",
  },
];
---

<section class="tf-doc-map">
  <h2 class="tf-doc-map__title">Documentation</h2>
  <div class="tf-doc-map__grid">
    {
      cards.map((card) => (
        <a class="tf-doc-map__card" href={card.href}>
          <h3 class="tf-doc-map__card-title">{card.title}</h3>
          <p class="tf-doc-map__card-desc">{card.description}</p>
          <span class="tf-doc-map__card-link">{card.linkLabel}</span>
        </a>
      ))
    }
  </div>
</section>
