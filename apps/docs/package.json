{
  "name": "@tsforge/docs",
  "type": "module",
  "private": true,
  "version": "0.36.0",
  "description": "tsforge docs — Astro Starlight product site.",
  "scripts": {
    "sync:rules": "bun scripts/sync-rules-catalog.ts",
    "check:rules": "cd ../.. && bun run rules:build && git diff --exit-code packages/core/RULES.md",
    "dev": "bun run sync:rules && astro dev",
    "start": "bun run sync:rules && astro dev",
    "build": "bun run sync:rules && astro build",
    "build:ci": "bun run check:rules && bun run sync:rules && astro build",
    "export:harness-board": "bun scripts/export-harness-board.mjs",
    "preview": "astro preview",
    "deploy": "bun run build:ci && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "6.0.1",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.5",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.3",
    "astro-mermaid": "2.1.0",
    "mermaid": "11.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reading-time": "1.5.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "wrangler": "4.114.0"
  }
}
